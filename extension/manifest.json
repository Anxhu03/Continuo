{
  "manifest_version": 3,
  "name": "Continuo — Context Continuity Companion",
  "version": "1.0.0",
  "description": "Capture project context across ChatGPT, Claude, and Gemini with one click. Never re-explain your work.",
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Continuo Context Companion",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "clipboardWrite",
    "tabs"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://continuo-api.onrender.com/*",
    "https://continuo-one.vercel.app/*",
    "http://127.0.0.1:8008/*",
    "http://localhost:8008/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://continuo-one.vercel.app/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "http://localhost:8008/*",
        "http://127.0.0.1:8008/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

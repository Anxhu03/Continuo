# ==============================================================================
# CONTINUO — Environment Configuration Template (.env.example)
# Copy this file to .env and configure for your local or production environment.
# ==============================================================================

# Server Environment (development | production)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8008

# Web Application Frontend URL
FRONTEND_URL=https://continuo.ai

# Allowed CORS Origins (Comma-separated)
# In development, includes local test ports (8000, 8008, 3000, 5173).
# In production, specify your live web domains:
CORS_ORIGINS=https://continuo.ai,https://www.continuo.ai,https://app.continuo.ai

# Authentication & Security
# IMPORTANT: Generate a secure 32+ character random string for production:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=continuo_dev_secret_key_9f8e7d6c5b4a3b2a1
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database Configuration
# Local Development (zero setup SQLite):
DATABASE_URL=sqlite:///./continuo.db

# Production PostgreSQL / Supabase / Neon / AWS RDS:
# Both postgresql:// and postgres:// are accepted (automatically normalized)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DATABASE]
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Chrome Extension Companion & Public API Endpoint
CONTINUO_API_URL=https://api.continuo.ai/api/v1

# Optional AI Provider API Keys (Used by server-side context engine if configured)
# If left empty, Continuo uses its native heuristic neural extraction rules.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

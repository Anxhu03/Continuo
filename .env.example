# ==============================================================================
# CONTINUO — Environment Configuration Template (.env.example)
# Copy this file to .env and configure for your local or production environment.
# ==============================================================================

# Server Environment
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8008

# Allowed CORS Origins (Comma-separated)
# In production, specify your web frontend domains (e.g. https://continuo.ai)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000

# Authentication & Security
# Generate a secure 32+ character random string: `openssl rand -hex 32`
SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database Configuration
# Default is SQLite for instant local zero-setup execution.
# For production PostgreSQL / Supabase, use:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DATABASE]
DATABASE_URL=sqlite:///./continuo.db

# Chrome Extension Companion Endpoint
EXTENSION_API_BASE_URL=http://127.0.0.1:8008/api/v1

# Optional AI Provider API Keys (Used by server-side context engine if configured)
# If left empty, Continuo uses its native heuristic neural extraction rules.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
